# ==========================================
# METO Bulk Video Downloader Configuration
# ==========================================
# Bu dosya deploy.sh tarafından otomatik oluşturulur.
# El ile düzenleyeceksen: cp .env.example .env

# ------------------------------------------
# Sunucu / Docker - Tak-Çalıştır
# ------------------------------------------
# Uygulama portu (sunucuda 80/5000 vb. çakışırsa değiştir)
PORT=5000
# Debug kapalı = production (0), açık = 1
BULK_VIDEO_DEBUG=0
# Session secret - deploy.sh otomatik üretir, elle üret: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-me-with-a-random-secret-key

# ------------------------------------------
# MySQL - Docker Compose (tak-çalıştır)
# ------------------------------------------
# docker-compose.yml içindeki `db` servisi bu değişkenleri kullanır.
# Hiçbir şey yapmadan `docker compose up` dersen varsayılanlar (rootsecret/bulkpass) ile çalışır.
# Production'da deploy.sh rastgele güçlü şifreler üretir.
MYSQL_ROOT_PASSWORD=rootsecret
MYSQL_DATABASE=bulk_video
MYSQL_USER=bulkuser
MYSQL_PASSWORD=bulkpass

# ------------------------------------------
# Database - Gelişmiş / Manuel
# ------------------------------------------
# Compose MySQL yerine harici DB kullanacaksan URL'i buraya yaz:
# BULK_VIDEO_DB_URL=mysql+pymysql://bulkuser:bulkpass@db:3306/bulk_video
# BULK_VIDEO_DB_URL=postgresql+psycopg2://user:pass@host:5432/bulk_video
# Ayrı ayrı format da desteklenir:
# BULK_VIDEO_DB_TYPE=mysql
# BULK_VIDEO_DB_HOST=db
# BULK_VIDEO_DB_PORT=3306
# BULK_VIDEO_DB_USER=bulkuser
# BULK_VIDEO_DB_PASSWORD=bulkpass
# BULK_VIDEO_DB_NAME=bulk_video

# SQLite fallback (sadece MySQL'siz manuel çalıştırmada):
# BULK_VIDEO_DB_PATH=bulk_video.db

# ------------------------------------------
# Authentication (Opsiyonel)
# ------------------------------------------
# Boş bırakırsan login kapalı, doldurursan giriş zorunlu olur.
# BULK_VIDEO_USERNAME=admin
# BULK_VIDEO_PASSWORD=secret

# ------------------------------------------
# Genel
# ------------------------------------------
BULK_VIDEO_VIDEO_DIR=videos
# BULK_VIDEO_STORAGE_MAX_MB=10240  # 10 GB limit örneği
