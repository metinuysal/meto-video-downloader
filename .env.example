# ==========================================
# METO Bulk Video Downloader Configuration
# ==========================================

# ------------------------------------------
# Database Configuration
# ------------------------------------------
# By default, the application uses an embedded SQLite database.
# To use MySQL or PostgreSQL instead, you can provide a connection string URL:
# BULK_VIDEO_DB_URL=mysql+pymysql://root:secret@127.0.0.1:3306/bulk_video
# BULK_VIDEO_DB_URL=postgresql+psycopg2://root:secret@127.0.0.1:5432/bulk_video

# Or use the classic individual configuration format:
# BULK_VIDEO_DB_TYPE=postgres  # or "mysql"
# BULK_VIDEO_DB_HOST=127.0.0.1
# BULK_VIDEO_DB_PORT=5432
# BULK_VIDEO_DB_USER=root
# BULK_VIDEO_DB_PASSWORD=secret
# BULK_VIDEO_DB_NAME=bulk_video

# Alternatively, you can change the location of the SQLite database file:
# BULK_VIDEO_DB_PATH=bulk_video.db

# ------------------------------------------
# Authentication (Optional)
# ------------------------------------------
# If you set a username and password, the app will require login.
# If these are left commented out or empty, the app will bypass login.
#
# BULK_VIDEO_USERNAME=admin
# BULK_VIDEO_PASSWORD=secret

# ------------------------------------------
# General Configuration
# ------------------------------------------
# Directory where downloaded videos are saved
BULK_VIDEO_VIDEO_DIR=videos

# Network Port to run the application on
PORT=5000

# Set to "1" or "true" to enable debug mode
BULK_VIDEO_DEBUG=false

# Secret key for session management (Required for auth in production)
# Generate one using: python -c "import secrets; print(secrets.token_hex(16))"
SECRET_KEY=replace-me-with-a-random-secret-key
